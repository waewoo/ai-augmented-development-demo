{
  "$schema": "https://app.kilo.ai/config.json",
  // Project rules are explicit so the demo can show how durable instructions
  // are loaded by the current Kilo Code configuration format.
  "instructions": [
    ".agents/rules/architecture.md",
    ".agents/rules/testing.md",
    ".agents/rules/reporting.md",
    ".agents/rules/security.md",
    ".agents/rules/python.md"
  ],
  "skills": {
    "paths": [".agents/skills"]
  }
}
